# 서비스: 기존 .env가 있으면 덮어쓰지 말고 필요한 변수만 추가하세요.
CLASSIFIER_TYPE=bert
BERT_MODEL_DIR=models/klue_bert_base
BERT_MAX_LENGTH=512
BASELINE_MODEL_PATH=models/tfidf_logistic_regression.joblib
DEFAULT_LLM=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
MAX_QUESTION_CHARS=500
LLM_TIMEOUT_S=30
CORS_ORIGINS=*
REQUEST_LOG_PATH=logs/requests.jsonl

# 화면에서 호출할 API (같은 PC이면 아래 값, 다른 PC이면 서버 IP)
CHAT_API_URL=http://127.0.0.1:8000

# 아래는 LLM 평가 실행 시 사용. 일반 챗봇 사용에는 API 키가 필요 없습니다.
EVAL_API_BASE_URL=http://127.0.0.1:8000
EVAL_REPEATS=3
EVAL_API_LOCAL_MODEL=qwen3.5:9b
EVAL_API_CLOUD_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
JUDGE_MODEL=gpt-6-luna
JUDGE_TEMPERATURE=
JUDGE_PRICE_INPUT_PER_1M=
JUDGE_PRICE_OUTPUT_PER_1M=
PRICE_CURRENCY=USD
PRICE_DATE=
